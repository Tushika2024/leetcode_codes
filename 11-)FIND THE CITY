#define P pair<int,int>
class Solution {
public:
    void graphformation(vector<vector<pair<int,int>>>&adjlist,
       vector<vector<int>>& edges,int n){
        for(auto it :edges){
            adjlist[it[0]].push_back({it[1],it[2]});
            adjlist[it[1]].push_back({it[0],it[2]});
        }
    }
    int findTheCity(int n, vector<vector<int>>& edges, int distanceThreshold) {
        vector<vector<pair<int,int>>>adjlist(n);
        graphformation(adjlist,edges,n);
        priority_queue<P,vector<P>,greater<P>>pq;
        vector<vector<int>>distance(n,vector<int>(n,1e9));
        for(int i=0;i<n;i++){
            pq.push({0,i});
            distance[i][i]=0;
            while(!pq.empty()){
                int cnode=pq.top().second;
                int cdis=pq.top().first;
                pq.pop();
                for(auto it :adjlist[cnode]){
                    int adjnode=it.first;
                    int adjdis=it.second;
                    if(cdis+adjdis<distance[i][adjnode]){
                        distance[i][adjnode]=cdis+adjdis;
                        pq.push({cdis+adjdis,adjnode});
                    }
                }
            }
        }
        int mincity=INT_MAX,cityno=-1;
        for(int i=0;i<n;i++){
            int count=0;
            for(int j=0;j<n;j++){
                if(distance[i][j]!=0 && 
                distance[i][j]<=distanceThreshold) count++;
            }
            if(count<=mincity){
                mincity=count;
                cityno=i;
            }
        }
        return cityno;
    }
