class Solution {
public:
    int findTheCity(int n, vector<vector<int>>& edges, int distanceThreshold) {
        vector<vector<int>>distance(n,vector<int>(n,1e9));
        for(int i=0;i<n;i++) distance[i][i]=0;
        for(int i=0;i<edges.size();i++){
            distance[edges[i][0]][edges[i][1]]=edges[i][2];
            distance[edges[i][1]][edges[i][0]]=edges[i][2];
        }
        for(int k=0;k<n;k++){
            for(int i=0;i<n;i++){
                for(int j=0;j<n;j++){
                    distance[i][j]=min(distance[i][j],
                    distance[i][k]+distance[k][j]);
                }
            }
        }
        int mincity=INT_MAX,cityno=-1;
        for(int i=0;i<n;i++){
            int count=0;
            for(int j=0;j<n;j++){
                if(distance[i][j]!=0 && 
                distance[i][j]<=distanceThreshold) count++;
            }
            if(count<=mincity){
                mincity=count;
                cityno=i;
            }
        }
        return cityno;
    }
};
};
