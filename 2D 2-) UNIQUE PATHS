RECURSION TC=O(2 POW M*N) SC=O(M+N)
MEMOIZATION-
class Solution {
public:
    int helper(int m,int n,int crow,int ccol,vector<vector<int>>&dp){
        if(crow>=m || ccol>=n) return 0;//TC=O(M*N) SC=O(M*N+(M+N))
        if(crow==m-1 && ccol==n-1) return 1;
        if(dp[crow][ccol]!=-1) return dp[crow][ccol];
        int c1=helper(m,n,crow+1,ccol,dp);
        int c2=helper(m,n,crow,ccol+1,dp);
        return dp[crow][ccol]=c1+c2;
    }

  TABULATION TC=O(M*N) SC=O(M*N)
    int uniquePaths(int m, int n) {
        vector<vector<int>>dp(m,vector<int>(n,-1));
        dp[m-1][n-1]=1;
        for(int i=m-1;i>=0;i--){
            for(int j=n-1;j>=0;j--){
                int tc=0;
                if(dp[i][j]==-1){
                    if(i+1<m) tc+=dp[i+1][j];
                    if(j+1<n) tc+=dp[i][j+1];
                    dp[i][j]=tc;
                }
               
            }
        }
        return dp[0][0];
    }

SPACE OPTIMISATION-
    class Solution {
public:
    int uniquePaths(int m, int n) {
        vector<int>prev(n,0);//TC=O(N*M) SC=O(N)
        for(int i=m-1;i>=0;i--){
            vector<int>temp(n,0);
            for(int j=n-1;j>=0;j--){
                int down=0;
                int right=0;
                if(i==m-1 && j==n-1)temp[j]=1;
                else{
                    if(i+1<m) down+=prev[j];
                    if(j+1<n) right+=temp[j+1];
                    temp[j]=down+right;
                }
            }
            prev=temp;
        }
        return prev[0];
    }
};  
};  
