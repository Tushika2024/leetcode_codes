RECURSION- TC=O(2 POW N*M) SC=O(M+N)
MEMOIZATION-
class Solution {
public:TC=O(M*N) SC=O(M*N)+O(M+N)(RECURSIVE STACK)
    int helper(vector<vector<int>>& obstacleGrid,
            vector<vector<int>>&dp,int crow,int ccol,int r,int c){
        if(crow>=r || ccol>=c || obstacleGrid[crow][ccol]) return 0;
        if(crow==r-1 && ccol==c-1) return 1;
        if(dp[crow][ccol]!=-1) return dp[crow][ccol];
        int c1=helper(obstacleGrid,dp,crow,ccol+1,r,c);
        int c2=helper(obstacleGrid,dp,crow+1,ccol,r,c);
        return dp[crow][ccol]=c1+c2;
    }
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int r=obstacleGrid.size();
        int c=obstacleGrid[0].size();
        vector<vector<int>>dp(r,vector<int>(c,-1));
        return helper(obstacleGrid,dp,0,0,r,c);
    }
};

TABULATION-TC=O(M*N) SC=O(M*N)
class Solution {
public:
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int r=obstacleGrid.size();
        int c=obstacleGrid[0].size();
        vector<vector<long long>>dp(r,vector<long long>(c,-1));
        if(obstacleGrid[r-1][c-1]) return 0;
        dp[r-1][c-1]=1;
        for(int i=r-1;i>=0;i--){
            for(int j=c-1;j>=0;j--){
                long long c1=0,c2=0;
                if(i==r-1 && j==c-1) continue;
                if(j+1<c && (!obstacleGrid[i][j])){
                    c1+=dp[i][j+1];
                }
                if(i+1<r && (!obstacleGrid[i][j])){
                    c2+=dp[i+1][j];
                }
                dp[i][j]=c1+c2;
            }
        }
        return (int)dp[0][0];
    }
};

SPACE OPTIMISATION- TC=O(M*N) SC=O(2N)
class Solution {
public:
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int r=obstacleGrid.size();
        int c=obstacleGrid[0].size();
        if(obstacleGrid[r-1][c-1]) return 0;
        vector<long long>prev(c,0);
        for(int i=r-1;i>=0;i--){
            vector<long long>temp(c,0);
            for(int j=c-1;j>=0;j--){
                long long c1=0,c2=0;
                if(i==r-1 && j==c-1) temp[j]=1;
                else{
                    if(j+1<c && !obstacleGrid[i][j]) c1+=temp[j+1];
                    if(i+1<r && !obstacleGrid[i][j]) c2+=prev[j];
                    temp[j]=c1+c2;
                }
                
            }
            prev=temp;
        }
        return (int)prev[0];
    }
};
