class Solution {           TC=O(N)+O(NLOGN)           SC=O(1)+O(LOGN)(RECURSIVE STACK)
public:
void heapifyDown(vector<int>&nums,int last,int idx){
    int gidx=idx;
    int lc=2*idx+1;
    int rc=2*idx+2;
    if(lc<=last && nums[lc]>nums[gidx]){
        gidx=lc;
    }
    if(rc<=last && nums[rc]>nums[gidx]) gidx=rc;
    if(gidx!=idx){
        swap(nums[gidx],nums[idx]);
        heapifyDown(nums,last,gidx);
    }
}
    void buildmaxheap(vector<int>&nums){
        int n=nums.size();
        for(int i=(n/2)-1;i>=0;i--){
            heapifyDown(nums,n-1,i);
        }
    }
    void heapSort(vector<int>&nums) {
        buildmaxheap(nums);  TC=O(NOT N LOGN AS LOWER LEVEL NODES NOT TAKE LOGN TIME)=>O(N)
        int last=nums.size()-1;
        while(last>0){TC=O(N)
            swap(nums[0],nums[last]);
            last--;                             
            heapifyDown(nums,last,0);TC=O(LOGN)
        }
    }
};
