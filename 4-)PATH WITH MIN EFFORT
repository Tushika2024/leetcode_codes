#define P pair<int,pair<int,int>>
class Solution {  //TC=ELOGV=>(N*M*4 LOG(N*M))SC=O(V)+O(V)+O(2*4)
public:
    int minimumEffortPath(vector<vector<int>>& heights) {
        int r=heights.size();
        int c=heights[0].size();
        priority_queue<P,vector<P>,greater<P>>pq;
        vector<vector<int>>diff(r,vector<int>(c,1e9));
        vector<int>delrow={-1,0,+1,0};
        vector<int>delcol={0,+1,0,-1};
        pq.push({0,{0,0}});
        diff[0][0]=0;
        while(!pq.empty()){
            int cdiff=pq.top().first;
            int crow=pq.top().second.first;
            int ccol=pq.top().second.second;
            pq.pop();
            if(crow==r-1 && ccol==c-1) return cdiff;
            for(int i=0;i<4;i++){
                int row=crow+delrow[i];
                int col=ccol+delcol[i];
                if(row>=0 && row<r && col>=0 && col<c){
                    int ans=abs(heights[row][col]-heights[crow][ccol]);
                    if(max(ans,cdiff)<diff[row][col]){
                        diff[row][col]=max(ans,cdiff);
                        pq.push({max(ans,cdiff),{row,col}});
                    }
                    
                }
            }
        }
        return 0;
    }
};
