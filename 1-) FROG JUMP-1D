class Solution {
public: //TC=O(N) SC=O(N)+O(N)
    int helper(vector<int>&heights,vector<int>&minen,int csteps,int n){
        if(csteps>=n) return INT_MAX;
        if(csteps==n-1) return 0;
        int p1=0,p2=0,t1=0,t2=0;
        if(csteps+1<n && minen[csteps+1]!=-1) p1=minen[csteps+1];
        else p1=helper(heights,minen,csteps+1,n);
        if(csteps+2<n && minen[csteps+2]!=-1) p2=minen[csteps+2];
        else p2=helper(heights,minen,csteps+2,n);
        if(csteps+1<n) t1=abs(heights[csteps+1]-heights[csteps]);
        if(csteps+2<n) t2=abs(heights[csteps+2]-heights[csteps]);
        minen[csteps]=min(p1+t1,p2+t2);
        return minen[csteps];
    }
    int frogJump(vector<int>& heights) {
        vector<int>minen(heights.size(),-1);
        return helper(heights,minen,0,heights.size());
    }
};

class Solution {
public: //TC=O(N) SC=O(N)
    int frogJump(vector<int>& heights) {
        int n=heights.size();
        vector<int>minen(n,0);
        for(int i=n-2;i>=0;i--){
            int t1=INT_MAX,t2=INT_MAX;
            if(i+1<n){
                t1=abs(heights[i+1]-heights[i])+minen[i+1];
            }
            if(i+2<n){
                t2=abs(heights[i+2]-heights[i])+minen[i+2];
            }
            minen[i]=min(t1,t2);
        }
        return minen[0];
    }
};
class Solution {
public: //TC=O(N) SC=O(1)
    int frogJump(vector<int>& heights) {
        int n=heights.size();
        if(n==1) return 0;
        int curr=0,prev=abs(heights[n-2]-heights[n-1]),nextprev=0;
        int i=n-3;
        while(i>=0){
            int t1=abs(heights[i+1]-heights[i])+prev;
            int t2=abs(heights[i+2]-heights[i])+nextprev;
            curr=min(t1,t2);
            nextprev=prev;
            prev=curr;
            i--;
        }
        return prev;
    }
};
