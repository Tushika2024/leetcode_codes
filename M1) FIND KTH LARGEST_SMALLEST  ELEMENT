int findKthLargest(vector<int>& nums, int k) {
        priority_queue<int>pq;
        for(int i=0;i<nums.size();i++){
            pq.push(nums[i]);
        }
        for(int i=0;i<k-1;i++){
            pq.pop();
        }
        return pq.top();
    }
OP-TC=O(N+KLOGN) SC=O(LOGN)
class Solution {
public:
    void heapifyDown(vector<int>&nums,int last,int idx){
        int gidx=idx;
        int lc=2*idx+1;
        int rc=2*idx+2;
        if(lc<=last && nums[lc]>nums[gidx]) gidx=lc;
        if(rc<=last && nums[rc]>nums[gidx]) gidx=rc;
        if(gidx!=idx){
            swap(nums[idx],nums[gidx]);
            heapifyDown(nums,last,gidx);
        }
    }
    void buildmaxheap(vector<int>&nums){
        int n=nums.size();
        for(int i=(n/2)-1;i>=0;i--){
            heapifyDown(nums,n-1,i);
        }
    }
    int kthLargestElement(vector<int>& nums, int k) {
        buildmaxheap(nums);
        int last=nums.size()-1;
        for(int i=0;i<k;i++){
            swap(nums[0],nums[last]);
            last--;
            heapifyDown(nums,last,0);
        }
        return nums[last+1];
    }
};
OPI- USING MIN HEAP  O(NLOGK)    SC=O(K)             IF K=N THEN OUR TC AND SC LEADS TO NLOGN AND N
 int kthLargestElement(vector<int>& nums, int k) {
        priority_queue<int,vector<int>,greater<int>>pq;
        for(int i=0;i<k;i++){      KLOGK
            pq.push(nums[i]);
        }
        for(int i=k;i<nums.size();i++){
            if(nums[i]>pq.top()){
                pq.pop();     N-KLOGK
                pq.push(nums[i]);
            }
        }
        return pq.top();
    }
OPII- QUICK Select algo AVG CASE = O(N)  WORST CASE =O(N2)  (CONSIDERED BEST SOLUTIO FOR THIS PRBLM)
    int randomPivot(vector<int>&nums,int left,int right){
        int range=right-left+1;
        return (rand()%range)+left;
    }
    int arrange(vector<int>&nums,int pindx,int left,int right){
        swap(nums[left],nums[pindx]);
        int idx=left+1;
        for(int j=left+1;j<=right;j++){
            if(nums[j]>nums[left]) swap(nums[idx++],nums[j]);
        }
        swap(nums[left],nums[idx-1]);
        return idx-1;
    }
    int kthLargestElement(vector<int>& nums, int k) {
        int l=0,r=nums.size()-1;
        while(true){
            int pindx=randomPivot(nums,l,r);
            int pivotindex=arrange(nums,pindx,l,r);
            if(pivotindex==k-1) return nums[pivotindex];
            else if(k-1<pivotindex) r=pivotindex-1;
            else l=pivotindex+1;
        }
        return -1;

