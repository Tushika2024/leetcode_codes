USING PQ
#define P pair<int,int>
class Solution{
public:
    vector<int> dijkstra(int V, vector<vector<int>> adj[], int S) {
        priority_queue<P,vector<P>,greater<P>>pq;
        vector<int>dis(V,1e9);
        dis[S]=0;
        pq.push({0,S});
        while(!pq.empty()){
            int cdis=pq.top().first;
            int cnode=pq.top().second;
            pq.pop();
            for(auto it : adj[cnode]){
                int adjnode=it[0];
                int adjdis=it[1];
                if(cdis+adjdis<dis[adjnode]){
                    dis[adjnode]=cdis+adjdis;
                    pq.push({dis[adjnode],adjnode});
                }
            }
        }
        return dis;
    }

USING QUEUE
#define P pair<int,int>
class Solution{
public:
    vector<int> dijkstra(int V, vector<vector<int>> adj[], int S) {
        queue<P>pq;
        vector<int>dis(V,1e9);
        dis[S]=0;
        pq.push({0,S});
        while(!pq.empty()){
            int cdis=pq.front().first;
            int cnode=pq.front().second;
            pq.pop();
            for(auto it : adj[cnode]){
                int adjnode=it[0];
                int adjdis=it[1];
                if(cdis+adjdis<dis[adjnode]){
                    dis[adjnode]=cdis+adjdis;
                    pq.push({dis[adjnode],adjnode});
                }
            }
        }
        return dis;
    }

USING SET-
#define P pair<int,int>
class Solution{
public:
    vector<int> dijkstra(int V, vector<vector<int>> adj[], int S) {
        set<P>st;
        vector<int>dis(V,1e9);
        dis[S]=0;
        st.insert({0,S});
        while(!st.empty()){
            auto it =*(st.begin());
            int cdis=it.first;
            int cnode=it.second;
            st.erase(it);
            for(auto it : adj[cnode]){
                int adjnode=it[0];
                int adjdis=it[1];
                if(cdis+adjdis<dis[adjnode]){
                    if(dis[adjnode]!=1e9) st.erase({dis[adjnode],adjnode});
                    dis[adjnode]=cdis+adjdis;
                    st.insert({dis[adjnode],adjnode});
                }
            }
        }
        return dis;
    }
};
