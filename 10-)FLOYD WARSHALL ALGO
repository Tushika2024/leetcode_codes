class Solution {
public: //TC=O(V3) SC=O(V*V)(SPACE USED TO SOLVE THE PROBLEM)
	void shortestDistance(vector<vector<int>>&matrix) {
		int v=matrix.size();
		for(int i=0;i<v;i++){
			for(int j=0;j<v;j++){
				if(matrix[i][j]==-1) matrix[i][j]=(int)1e9;
			}
		}
		for(int k=0;k<v;k++){
			for(int i=0;i<v;i++){
				for(int j=0;j<v;j++){
					matrix[i][j]=min(matrix[i][j],matrix[i][k]+matrix[k][j]);
				}
			}
		}
		// for(int i=0;i<v;i++){
		// 	if(matrix[i][i]<0) return "negative weight cycle";
		// }
		for(int i=0;i<v;i++){
			for(int j=0;j<v;j++){
				if(matrix[i][j]==1e9) matrix[i][j]=-1;
			}
		}
	}
};
