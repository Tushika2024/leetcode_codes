class Solution{
public:
    void bfs(vector<vector<char>> &grid,vector<int>&delrow,
        vector<int>&delcol,int crow,int ccol,queue<pair<int,int>>&q){
        q.push({crow,ccol});
        grid[crow][ccol]='0';
        while(!q.empty()){
            pair<int,int> el=q.front();
            q.pop();
            for(int i=0;i<8;i++){
                int nrow=delrow[i]+el.first;
                int ncol=delcol[i]+el.second;
                if(nrow>=0 && ncol>=0
                && nrow<grid.size() && ncol<grid[0].size()&&
                grid[nrow][ncol]=='1') {
                    q.push({nrow,ncol});
                    grid[nrow][ncol]='0';
                }
            }
        }
    }
    int numIslands(vector<vector<char>> &grid){//TC=O(N*M+N*M*8) SC=O(N*M)
        int totalis=0;
        int rows=grid.size();//USE VISITED SEPEARATE NOT MODIFY ORIGINAL ARRAY
        int cols=grid[0].size();
        queue<pair<int,int>>q;//r,c
        vector<int>delrow={-1,0,+1,0,-1,+1,+1,-1};
        vector<int>delcol={0,+1,0,-1,+1,+1,-1,-1};
        while(!q.empty()){}
        for(int i=0;i<rows;i++){
            for(int j=0;j<cols;j++){
                if(grid[i][j]=='1'){
                    totalis++;
                    bfs(grid,delrow,delcol,i,j,q);
                }
            }
            
        }
        return totalis;
    }
};
