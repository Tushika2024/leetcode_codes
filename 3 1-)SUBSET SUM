MEMOIZATION-TC=O(N*TARGET) SC=O(N*TARGET)+O(N)
class Solution{   
public:
    int helper(int idx,int ctarget,vector<int>&arr){
        if(!ctarget) return 1;
        if(idx==0 && arr[0]==ctarget) return 1;
        int ntake=helper(idx-1,ctarget,arr);
        int take=0;
        if(arr[idx]>=ctarget)  int take=helper(idx-1,ctarget-arr[idx],arr);
        return ntake||take;
    }
    bool isSubsetSum(vector<int>arr, int target){
        int n=arr.size();
        if(helper(n-1,target,arr)) return true;
        return false;
    }
};

TABULATION- TC=O(N*TARGET) SC=O(N*TARGET)
class Solution{   
public:
    bool isSubsetSum(vector<int>arr, int target){
        int n=arr.size();
        vector<vector<int>>dp(n,vector<int>(target+1,0));
        for(int i=0;i<n;i++){
            dp[i][0]=1;
        }
        if(arr[0]<=target) dp[0][arr[0]]=1;
        for(int idx=1;idx<n;idx++){
            for(int tar=1;tar<=target;tar++){
                int ntake=dp[idx-1][tar];
                int take=0;
                if(arr[idx]<=tar) take=dp[idx-1][tar-arr[idx]];
                dp[idx][tar]=ntake||take;
            }
        }
        return dp[n-1][target]==1;
    }
};

SPACE OPTIMISATION-tc=O(N*TARGET) SC=O(2*TARGET)
class Solution{   
public:
    bool isSubsetSum(vector<int>arr, int target){
        int n=arr.size();
        vector<int>prev(target+1,0);
        prev[0]=1;
        if(arr[0]<=target) prev[arr[0]]=1;
        for(int idx=1;idx<n;idx++){
            vector<int>curr(target+1,0);
            curr[0]=1;
            for(int tar=1;tar<=target;tar++){
                int ntake=prev[tar];
                int take=0;
                if(arr[idx]<=tar) take=prev[tar-arr[idx]];
                curr[tar]=ntake||take;
            }
            prev=curr;
        }
        return prev[target]==1;
    }
};
