class Solution { //recursive solution also
public://TC=O(N) SC=O(1)
    int jump(vector<int>& nums) {
        int l=0,r=0,jumps=0;
        while(r<nums.size()-1){
            int fidx=0;
            for(int i=l;i<=r;i++){
                fidx=max(fidx,i+nums[i]);
            }
            l=r+1;
            r=fidx;
            jumps++;
        }
        return jumps;
        }
    };
