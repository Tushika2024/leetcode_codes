#define P pair<long long,int>
class Solution {
public:
    void graphformation(vector<vector<pair<int,int>>>&adjlist,
        vector<vector<int>>& roads,int n){
    for(int i=0;i<roads.size();i++){
        adjlist[roads[i][0]].push_back({roads[i][1],roads[i][2]});
        adjlist[roads[i][1]].push_back({roads[i][0],roads[i][2]});
        }
    }
    int countPaths(int n, vector<vector<int>>& roads) {
        vector<vector<pair<int,int>>>adjlist(n);
        graphformation(adjlist,roads,n);
        vector<long long>distance(n,1e15);
        vector<long long>freq(n,0);
        priority_queue<P,vector<P>,greater<P>>pq;
        pq.push({0,0});
        distance[0]=0;
        freq[0]=1;
        long long mod=1e9+7;
        while(!pq.empty()){
            long long cdis=pq.top().first;
            int cnode=pq.top().second;
            pq.pop();
            for(auto it : adjlist[cnode]){
                int adjnode=it.first;
                int adjdis=it.second;
                if(cdis+adjdis<distance[adjnode]){
                    distance[adjnode]=cdis+adjdis;
                    freq[adjnode]=freq[cnode];
                    pq.push({cdis+adjdis,adjnode});
                }else if(cdis+adjdis==distance[adjnode])
                    freq[adjnode]=(freq[adjnode]+freq[cnode])%mod;
            }
        }
        return (int)freq[n-1];
    }
};
