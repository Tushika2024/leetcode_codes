1- FOR SINGLE ELEMENT OF PASCALS TRIANGLE USE nCr CONCEPT;         TC=O(N)
int findncr(int cr,int cc){                                           O(MIN(CC,CR-CC)  SC=O(1)
        if(cc==0 || cc==cr) return 1;
        long long ans=1;
        if(cc>(cr-cc)) cc=cr-cc;
        for(int i=0;i<cc;i++){
            ans=(ans*(cr-i))/(i+1);
        }
        return ans;
    }
    int pascalTriangleI(int r, int c) {
        int cr=r-1;
        int cc=c-1;
        return (int)findncr(cr,cc);
    }

