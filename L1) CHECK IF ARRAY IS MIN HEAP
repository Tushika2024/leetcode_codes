
bool isHeap(vector<int>& nums) {
        for(int i=nums.size()-1;i>=0;i--){
            int pidx=(i-1)/2;   TC=O(N) SC=O(1)
            if(pidx>=0 && nums[pidx]>nums[i]) return false;
        }
        return true;
    }

OR
 bool isHeap(vector<int>& nums) {
        int n=nums.size();  TC=O(N/2) SC=O(1)
        for(int i=(n/2)-1;i>=0;i--){
            int lc=2*i+1;
            int rc=2*i+2;
            if(lc<n && nums[lc]<nums[i]) return false;
            if(rc<n && nums[rc]<nums[i]) return false;
        }
        return true;
    }
