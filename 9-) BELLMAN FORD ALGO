#define P pair<int,int>
class Solution {
public:
	vector<int> bellman_ford(int V, vector<vector<int>>& edges, int S) {
		vector<int>distance(V,1e9);  //TC=O(V*E) SC=O(V)
		distance[S]=0;
		for(int i=0;i<V;i++){
			for(auto it:edges){
				int u=it[0];
				int v=it[1];
				int dis=it[2];
				if(distance[u]!=1e9 && distance[u]+dis<distance[v])
					distance[v]=distance[u]+dis;
			}
		}
		for(auto it:edges){
				int u=it[0];
				int v=it[1];
				int dis=it[2];
				if(distance[u]!=1e9 && distance[u]+dis<distance[v])
					return {-1};
		}
		return distance;
	}

};
